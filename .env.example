# Peace at Peak - Resort Website Environment Configuration
# Copy these values into your .env file or Vercel Project Settings -> Environment Variables

# ============================================================================
# Firebase Database & Storage Configuration
# Get from: https://console.firebase.google.com -> Project Settings -> General
# ============================================================================
VITE_FIREBASE_API_KEY=AIzaSyYOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=peace-at-peak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=peace-at-peak
VITE_FIREBASE_STORAGE_BUCKET=peace-at-peak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================================================
# Razorpay Payment Gateway
# Get from: https://dashboard.razorpay.com -> Settings -> API Keys
# Test Key format: rzp_test_... | Live Key format: rzp_live_...
# ============================================================================
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# ============================================================================
# Company WhatsApp Business Profile Automated Dispatch API
# When guests book & pay, the serverless API (/api/send-whatsapp) automatically
# sends the reservation voucher & payment confirmation directly to their WhatsApp.
# Choose ANY ONE of the following options:
# ============================================================================

# --- OPTION 1: Meta WhatsApp Business Cloud API (Official WhatsApp Platform) ---
# Create a Meta App at https://developers.facebook.com -> WhatsApp -> API Setup
# 1. System User Permanent Access Token:
WHATSAPP_CLOUD_TOKEN=EAAG...YOUR_META_PERMANENT_ACCESS_TOKEN
# 2. WhatsApp Phone Number ID (from API Setup tab):
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# 3. Optional Pre-Approved Template Name (e.g. reservation_confirmation):
# WHATSAPP_TEMPLATE_NAME=reservation_confirmation

# --- OPTION 2: UltraMsg (Fastest - Connects your company's phone WhatsApp in 60s) ---
# Get instance & scan QR at https://ultramsg.com with your WhatsApp Business app
# ULTRAMSG_INSTANCE_ID=instance12345
# ULTRAMSG_TOKEN=abcdef123456

# --- OPTION 3: Wati API (Leading Indian WhatsApp Business Partner) ---
# Get from https://live.wati.io -> API Docs
# WATI_API_ENDPOINT=https://live-server-XXXX.wati.io
# WATI_ACCESS_TOKEN=your_wati_token_here

# --- OPTION 4: Twilio WhatsApp API ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- OPTION 5: Custom Webhook (Zapier / Make / n8n / Aisensy) ---
# WHATSAPP_WEBHOOK_URL=https://your-webhook-url.com
