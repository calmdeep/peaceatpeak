# Peace at Peak - Firebase Configuration Template
# Copy these values into your .env file or Vercel Environment Variables
# Get these keys from: https://console.firebase.google.com -> Project Settings -> General -> Your Apps (Web)

VITE_FIREBASE_API_KEY=AIzaSyYOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=peace-at-peak.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=peace-at-peak
VITE_FIREBASE_STORAGE_BUCKET=peace-at-peak.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Razorpay Payment Gateway Configuration
# Get your Key ID from: https://dashboard.razorpay.com -> Settings -> API Keys
# Test Key format: rzp_test_... | Live Key format: rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

# ============================================================================
# Automated Background WhatsApp Gateway (Customer Instant Delivery)
# Add ONE of the following options in your .env or Vercel Environment Variables:
# ============================================================================

# OPTION 1: UltraMsg (Recommended - Instant 1-minute QR scan with resort phone)
# Get from https://ultramsg.com (Free trial available)
# ULTRAMSG_INSTANCE_ID=instance12345
# ULTRAMSG_TOKEN=abcdef123456

# OPTION 2: Meta WhatsApp Business Cloud API (Official Meta Graph API)
# Get from https://developers.facebook.com -> WhatsApp -> API Setup
# WHATSAPP_CLOUD_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# OPTION 3: Twilio WhatsApp
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OPTION 4: Custom Webhook (Zapier / Make / Wati / Aisensy)
# WHATSAPP_WEBHOOK_URL=https://your-webhook-url.com
